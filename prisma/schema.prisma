generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model users {
  id                                       BigInt         @id @default(autoincrement())
  username                                 String?        @db.VarChar(255)
  password                                 String?        @db.VarChar(255)
  conversation_conversation_userid1Tousers conversation[] @relation("conversation_userid1Tousers")
  conversation_conversation_userid2Tousers conversation[] @relation("conversation_userid2Tousers")
  messages                                 messages[]
}

model conversation {
  id                                Int        @id @default(autoincrement())
  userid1                           BigInt
  userid2                           BigInt
  users_conversation_userid1Tousers users      @relation("conversation_userid1Tousers", fields: [userid1], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_conversation_userid2Tousers users      @relation("conversation_userid2Tousers", fields: [userid2], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages                          messages[]
}

model messages {
  id             Int          @id @default(autoincrement())
  conversationid Int
  text           String       @db.VarChar(255)
  senderid       BigInt
  sentat         DateTime     @default(now()) @db.Timestamptz(6)
  conversation   conversation @relation(fields: [conversationid], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users        @relation(fields: [senderid], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
